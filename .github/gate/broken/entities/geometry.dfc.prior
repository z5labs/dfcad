; `entities/geometry.dfc` as the merge base holds it, and nothing else.
;
; It is not walked — the loader reads `.dfc` and this is not one — so it is
; inert to every stage of the gate. The self-test copies it over
; `entities/geometry.dfc` to make the base commit of the throwaway repository it
; builds, then puts the working copy back for the head commit. That is what
; gives the review stage two revisions to compare without this directory having
; to hold two copies of a model which differ in one number.
;
; The one number is the east corner: 4.0 m here, 4.6 m there, under the same
; claim id and the same survey. A corner rewritten in place is what
; `boundary-moved-without-claim` reports, and its default ruling is a warning —
; so the annotation it produces is also the only one the gate emits at a level
; other than error, which is the other half of what the review filter has to
; get right.
(vertex
  geom:V-01
  (label "North-west corner")
  (frame frame:building)
  (position
    (value (0.0 0.0 0.0) m)
    (source "Interior control set IC-01, Acme Surveys")
    (method method:total-station)
    (accuracy (independent 0.004 m))
    (date "2026-02-18")))
(vertex
  geom:V-02
  (label "North-east corner")
  (frame frame:building)
  (position
    (value (4.0 0.0 0.0) m)
    (source "Interior control set IC-01, Acme Surveys")
    (method method:total-station)
    (accuracy (independent 0.004 m))
    (date "2026-02-18")))
(vertex
  geom:V-03
  (label "South-east corner")
  (frame frame:building)
  (position
    (value (4.0 3.0 0.0) m)
    (source "Interior control set IC-01, Acme Surveys")
    (method method:total-station)
    (accuracy (independent 0.004 m))
    (date "2026-02-18")))
(vertex
  geom:V-04
  (label "South-west corner")
  (frame frame:building)
  (position
    (value (0.0 3.0 0.0) m)
    (source "Interior control set IC-01, Acme Surveys")
    (method method:total-station)
    (accuracy (independent 0.004 m))
    (date "2026-02-18")))
(vertex
  geom:V-05
  (label "North-west corner, as the west wall reaches it")
  (frame frame:building)
  (position
    (value (0.0 0.3 0.0) m)
    (source "Interior control set IC-01, Acme Surveys")
    (method method:total-station)
    (accuracy (independent 0.004 m))
    (date "2026-02-18")))
(edge
  geom:E-01
  (label "North wall")
  (frame frame:building)
  (vertices geom:V-01 geom:V-02))
(edge
  geom:E-02
  (label "East wall")
  (frame frame:building)
  (vertices geom:V-02 geom:V-03))
(edge
  geom:E-03
  (label "South wall")
  (frame frame:building)
  (vertices geom:V-03 geom:V-04))
(edge
  geom:E-04
  (label "West wall")
  (frame frame:building)
  (vertices geom:V-04 geom:V-05))
(loop
  geom:L-01
  (label "Meeting Room B outline")
  (frame frame:building)
  (edges geom:E-01 geom:E-02 geom:E-03 geom:E-04))
