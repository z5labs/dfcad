; The outline of Meeting Room B, and what the second and third stages of the
; gate each have to say about it.
;
; It does not close. The west wall stops three hundred millimetres short of the
; corner the north wall began at, which is sixty times the closure tolerance, so
; the invariant the registry writes on MeetingRoom fails on the room this
; outline belongs to. That is a violation with a span on it, which is what the
; check stage's filter reads out of the output contract — and it needs a model
; which loads, so it cannot live in the root beside this one.
;
; The east corner is the other fault, and it is a fault only as a change. The
; claim there says something different from what the merge base's copy of this
; file said, under the same claim id and with the same survey behind it: the
; room got six hundred millimetres wider and nothing was measured to account for
; it. No rule over one revision can see that. This file loads, it is canonical,
; and the closure failure above is the only thing `dfcad check` has to say.
;
; `entities/geometry.dfc.prior` is this file as the merge base holds it. The
; self-test commits that first and this second, so the review stage has two
; revisions to compare and a finding with a span to annotate. The two files are
; a pair: a corner moved here has to move there as well, or the change under
; review stops being the one this comment describes.
(vertex
  geom:V-01
  (label "North-west corner")
  (frame frame:building)
  (position
    (value (0.0 0.0 0.0) m)
    (source "Interior control set IC-01, Acme Surveys")
    (method method:total-station)
    (accuracy (independent 0.004 m))
    (date "2026-02-18")))
(vertex
  geom:V-02
  (label "North-east corner")
  (frame frame:building)
  (position
    (value (4.6 0.0 0.0) m)
    (source "Interior control set IC-01, Acme Surveys")
    (method method:total-station)
    (accuracy (independent 0.004 m))
    (date "2026-02-18")))
(vertex
  geom:V-03
  (label "South-east corner")
  (frame frame:building)
  (position
    (value (4.0 3.0 0.0) m)
    (source "Interior control set IC-01, Acme Surveys")
    (method method:total-station)
    (accuracy (independent 0.004 m))
    (date "2026-02-18")))
(vertex
  geom:V-04
  (label "South-west corner")
  (frame frame:building)
  (position
    (value (0.0 3.0 0.0) m)
    (source "Interior control set IC-01, Acme Surveys")
    (method method:total-station)
    (accuracy (independent 0.004 m))
    (date "2026-02-18")))
(vertex
  geom:V-05
  (label "North-west corner, as the west wall reaches it")
  (frame frame:building)
  (position
    (value (0.0 0.3 0.0) m)
    (source "Interior control set IC-01, Acme Surveys")
    (method method:total-station)
    (accuracy (independent 0.004 m))
    (date "2026-02-18")))
(edge
  geom:E-01
  (label "North wall")
  (frame frame:building)
  (vertices geom:V-01 geom:V-02))
(edge
  geom:E-02
  (label "East wall")
  (frame frame:building)
  (vertices geom:V-02 geom:V-03))
(edge
  geom:E-03
  (label "South wall")
  (frame frame:building)
  (vertices geom:V-03 geom:V-04))
(edge
  geom:E-04
  (label "West wall")
  (frame frame:building)
  (vertices geom:V-04 geom:V-05))
(loop
  geom:L-01
  (label "Meeting Room B outline")
  (frame frame:building)
  (edges geom:E-01 geom:E-02 geom:E-03 geom:E-04))
