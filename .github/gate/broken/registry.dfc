; The vocabulary of the deliberately broken model.
;
; This file is correct and canonical on purpose. What is wrong with this model
; is in the files beside it, so that the self-test can say which stage of the
; gate caught which fault rather than watching one mistake fail everything.
(project
  (label "Gate self-test")
  (globalid-namespace "https://example.org/models/gate-self-test"))
(namespace frame (description "Coordinate frames declared by this model."))
(namespace geom (description "Geometric nodes minted by this model."))
(namespace method (description "Measurement methods used on this project."))
(namespace site (description "Semantic nodes minted by this model."))
(type
  MeetingRoom
  (kind Space)
  (geometry area)
  (description "An enclosed room used for meetings.")
  (invariant
    boundary-loops-close
    (position position)
    (tolerance boundary-closure)))
(predicate
  position
  (unit m)
  (shape coordinate)
  (dimension 3)
  (description "The location of a vertex in its frame."))
(tolerance
  boundary-closure
  (value 0.005 m)
  (description "How far a loop may fail to close and still count as closed."))
(frame frame:building (label "Building local grid") (unit m))
