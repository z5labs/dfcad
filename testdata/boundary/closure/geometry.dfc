    (date "2026-02-18")))

(edge geom:E-11 (frame frame:building) (vertices geom:V-11 geom:V-12))

(edge geom:E-12 (frame frame:building) (vertices geom:V-12 geom:V-13))

(edge geom:E-13 (frame frame:building) (vertices geom:V-13 geom:V-14))

; The west wall begins a quarter of a metre from where the south wall ended.
(edge geom:E-14 (frame frame:building) (vertices geom:V-15 geom:V-11))

(loop geom:L-11
  (label "The ring with a gap in it")
  (frame frame:building)
  (edges geom:E-11 geom:E-12 geom:E-13 geom:E-14))

