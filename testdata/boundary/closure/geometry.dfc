; Two rings which do not meet themselves, and the tolerance which decides
; whether that matters.
;
; The first is out by a quarter of a metre, which is an edge naming the wrong
; corner. The second is out by four millimetres, which is one corner surveyed
; twice by two crews — and a model calling that an open loop would report a gap
; on every honest building in it.
(vertex geom:V-11
  (frame frame:building)
  (position
    (value (0.0 0.0 0.0) m)
    (source "Interior control set IC-01, Acme Surveys")
    (method method:total-station)
    (accuracy (independent 0.004 m))
    (date "2026-02-18")))

(vertex geom:V-12
  (frame frame:building)
  (position
    (value (4.0 0.0 0.0) m)
    (source "Interior control set IC-01, Acme Surveys")
    (method method:total-station)
    (accuracy (independent 0.004 m))
    (date "2026-02-18")))

