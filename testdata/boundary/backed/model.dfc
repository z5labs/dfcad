; Two rooms which share a wall, and what actually separates them.
;
; Nothing in this file says "physical" or "virtual". Each edge either names the
; elements which realise it or names none, and the classification is computed
; from that alone — so adding a wall makes a boundary physical with no second
; edit, and the answer cannot drift away from what the model says.
(node site:S-101
  (label "Meeting Room B")
  (kind Space)
  (type MeetingRoom)
  (geometry area)
  (frame frame:building)
  (boundary geom:L-01))

(node site:S-102
  (label "East Corridor")
  (kind Space)
  (type Corridor)
  (geometry area)
  (frame frame:building)
  (boundary geom:L-02))

; The elements. Each is a node of the semantic family like the rooms are, and
; nothing about it says which edge it backs: the edge names the element, never
; the other way round.
(node site:W-14
  (label "Stud partition, room B to corridor")
  (kind Element)
  (type Partition)
  (geometry line)
  (frame frame:building))

(node site:W-15
  (label "Glazed screen over the partition")
  (kind Element)
  (type GlazedScreen)
  (geometry line)
  (frame frame:building))

(node site:W-16
  (label "Corridor north wall")
  (kind Element)
  (type Partition)
  (geometry line)
  (frame frame:building))

(vertex geom:V-01 (label "Room B, north-west corner") (frame frame:building))

(vertex geom:V-02 (label "The shared wall, north end") (frame frame:building))

(vertex geom:V-03 (label "The shared wall, south end") (frame frame:building))

(vertex geom:V-04 (label "Room B, south-west corner") (frame frame:building))

(vertex geom:V-05 (label "Corridor, north-east corner") (frame frame:building))

(vertex geom:V-06 (label "Corridor, south-east corner") (frame frame:building))

; Room B's north wall is an opening onto the corridor: nothing realises it, so
; it is a virtual boundary.
(edge geom:E-01 (label "Room B, north opening") (frame frame:building) (vertices geom:V-01 geom:V-02))

; The shared partition, realised by two elements. A stud wall with a glazed
; screen over it is two things, and asking what separates the rooms has to name
; both of them rather than whichever was written first.
(edge geom:E-02
  (label "Partition, room B to corridor")
  (frame frame:building)
  (vertices geom:V-02 geom:V-03)
  (backed-by site:W-14)
  (backed-by site:W-15))

(edge geom:E-03 (label "Room B, south wall") (frame frame:building) (vertices geom:V-03 geom:V-04))

(edge geom:E-04 (label "Room B, west wall") (frame frame:building) (vertices geom:V-04 geom:V-01))

; The corridor's north wall, realised by one element.
(edge geom:E-05
  (label "Corridor, north wall")
  (frame frame:building)
  (vertices geom:V-02 geom:V-05)
  (backed-by site:W-16))

(edge geom:E-06 (label "Corridor, east wall") (frame frame:building) (vertices geom:V-05 geom:V-06))

(edge geom:E-07 (label "Corridor, south wall") (frame frame:building) (vertices geom:V-06 geom:V-03))

(loop geom:L-01
  (label "Meeting Room B boundary")
  (frame frame:building)
  (edges geom:E-01 geom:E-02 geom:E-03 geom:E-04))

(loop geom:L-02
  (label "East Corridor boundary")
  (frame frame:building)
  (edges geom:E-05 geom:E-06 geom:E-07 geom:E-02))
