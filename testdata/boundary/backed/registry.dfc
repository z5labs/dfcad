; The vocabulary the model beside this file is judged against.
;
; The two element types are the point of it. What physically realises a boundary
; is a node of kind Element like any other, declared here rather than compiled
; into the engine, and an edge naming one is what makes that boundary physical.
(project
  (label "Backed boundary fixture")
  (globalid-namespace "https://example.org/models/backed"))

(namespace frame (description "Coordinate frames declared by this model."))
(namespace geom (description "Geometric nodes minted by this model."))
(namespace site (description "Semantic nodes minted by this model."))

(frame frame:building (label "Building local grid") (unit m))

(type MeetingRoom
  (kind Space)
  (geometry area)
  (description "An enclosed room used for meetings."))

(type Corridor
  (kind Space)
  (geometry area)
  (description "A circulation space between rooms."))

(type Partition
  (kind Element)
  (geometry line)
  (description "A non-loadbearing wall between two spaces."))

(type GlazedScreen
  (kind Element)
  (geometry line)
  (description "A glazed panel carried above or beside a partition."))
