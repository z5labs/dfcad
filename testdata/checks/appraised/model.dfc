; The rooms an appraisal counts. A zone is never written within anything, so it
; is not a content of the storey and no sum over the storey's contents reaches
; it; it is named by the rules which sum its members.
(node site:Z-LIV
  (label "Living area")
  (kind Zone)
  (type LivingArea)
  (frame frame:building))

; The main floor, and the three questions asked of it. Its outline is eighty
; square metres, its living rooms are sixty, and the appraisal says sixty — so
; the sum over everything agrees with the outline, and the sum over the living
; rooms agrees with the figure, whether the living rooms are named by their type
; or by the zone which lists them.
(node site:L-01
  (label "Main floor")
  (kind Storey)
  (type Level)
  (geometry area)
  (frame frame:building)
  (boundary geom:L-01)
  (gross-living-area
    (value 60.0 m2)
    (source "Appraisal AP-2026-114, Fair Value Associates")
    (method method:total-station)
    (accuracy (independent 0.05 m2))
    (date "2026-03-02"))
  (assert contained-areas-sum
    (tolerance boundary-closure)
    (area-tolerance area-sum)
    (position position))
  (assert contained-areas-sum
    (tolerance boundary-closure)
    (area-tolerance area-sum)
    (position position)
    (predicate gross-living-area)
    (type LivingSpace))
  (assert contained-areas-sum
    (tolerance boundary-closure)
    (area-tolerance area-sum)
    (position position)
    (predicate gross-living-area)
    (member-of site:Z-LIV)))

