; Edges between two different vertices, which the load accepts, and whether the
; two stand at two places, which it does not ask.

(vertex geom:V-01
  (frame frame:building)
  (position
    (value (0.0 0.0) m)
    (source "Interior control set IC-01, Acme Surveys")
    (method method:total-station)
    (accuracy (independent 0.004 m))
    (date "2026-02-18")))

(vertex geom:V-02
  (frame frame:building)
  (position
    (value (4.0 0.0) m)
    (source "Interior control set IC-01, Acme Surveys")
    (method method:total-station)
    (accuracy (independent 0.004 m))
    (date "2026-02-18"))
  (label-anchor
    (value (0.0 0.0) m)
    (source "Sheet A-101")
    (method method:drawing-take-off)
    (date "2026-02-18")))

; V-01 copied under a new id: the same corner written twice.
(vertex geom:V-03
  (frame frame:building)
  (position
    (value (0.0 0.0) m)
    (source "Interior control set IC-01, Acme Surveys")
    (method method:total-station)
    (accuracy (independent 0.004 m))
    (date "2026-02-18")))

; Placed at V-01 once, and then re-surveyed somewhere else: the retracted
; position is not where it stands.
(vertex geom:V-04
  (frame frame:building)
  (position
    (id survey:P-0001)
    (value (0.0 0.0) m)
    (source "Interior control set IC-01, Acme Surveys")
    (method method:total-station)
    (accuracy (independent 0.004 m))
    (date "2026-02-18")
    (rank deprecated)
    (superseded-by survey:P-0002))
  (position
    (id survey:P-0002)
    (value (0.0 3.0) m)
    (source "As-built check AB-2026-009, Acme Surveys")
    (method method:total-station)
    (accuracy (independent 0.003 m))
    (date "2026-05-06")))

; Two positions nothing separates, one of them on top of V-01: no one place to
; compare, so nothing is decided here and the conflict register reports it.
(vertex geom:V-05
  (frame frame:building)
  (position
    (value (0.0 0.0) m)
    (source "Interior control set IC-01, Acme Surveys")
    (method method:total-station)
    (accuracy (independent 0.004 m))
    (date "2026-02-18"))
  (position
    (value (0.0 5.0) m)
    (source "Interior control set IC-02, Acme Surveys")
    (method method:total-station)
    (accuracy (independent 0.004 m))
    (date "2026-02-18")))

; An extent: satisfied.
(edge geom:E-01 (frame frame:building) (vertices geom:V-01 geom:V-02) (assert edge-endpoints-differ))

; No extent: fails.
(edge geom:E-02 (frame frame:building) (vertices geom:V-01 geom:V-03) (assert edge-endpoints-differ))

; The superseded position coincides and the current one does not: satisfied.
(edge geom:E-03 (frame frame:building) (vertices geom:V-01 geom:V-04) (assert edge-endpoints-differ))

; Ambiguous at one end: satisfied, and left to the conflict register.
(edge geom:E-04 (frame frame:building) (vertices geom:V-01 geom:V-05) (assert edge-endpoints-differ))

; V-02's tag is drawn where V-01 stands, which is a coordinate under another
; predicate V-01 carries nothing under: satisfied.
(edge geom:E-05 (frame frame:building) (vertices geom:V-02 geom:V-01) (assert edge-endpoints-differ))
