; Every way a subject can stand under a rule requiring a claim, one subject each.
;
; The rule asks whether anything is still asserted under the predicate. What it
; does not ask is which of several claims is current, or whether any of them can
; be ranked: those are resolution's answers, and a rule requiring a claim is
; satisfied by one somebody made whether or not it settles on a value.

; A width, still asserted: satisfied.
(node site:S-101
  (label "Meeting Room A")
  (kind Space)
  (type MeetingRoom)
  (width
    (id survey:W-0001)
    (value 4.2 m)
    (source "As-built check AB-2026-009, Acme Surveys")
    (method method:total-station)
    (accuracy (independent 0.003 m))
    (date "2026-05-06")))

; No width at all: fails the type's invariant.
(node site:S-102
  (label "Meeting Room B")
  (kind Space)
  (type MeetingRoom))

; A width which was retracted and replaced by a claim about another room: there
; is nothing asserted about this one any longer, so it fails.
(node site:S-103
  (label "Meeting Room C")
  (kind Space)
  (type MeetingRoom)
  (width
    (id survey:W-0003)
    (value 4.2 m)
    (source "Fit-out drawing FD-2026-011")
    (method method:drawing-take-off)
    (accuracy (independent 0.05 m))
    (date "2026-03-02")
    (rank deprecated)
    (superseded-by survey:W-0001)))

; One width with no accuracy: unrankable, so resolution picks nothing, and still
; what the model says about the room. Satisfied.
(node site:S-104
  (label "Meeting Room D")
  (kind Space)
  (type MeetingRoom)
  (width
    (value 3.1 m)
    (source "Estimate from the lease plan")
    (method method:estimate)
    (date "2026-01-12")))

; Two widths nothing separates: ambiguous, and both claimed. Satisfied here, and
; reported by the conflict register rather than a second time by this rule.
(node site:S-105
  (label "Meeting Room E")
  (kind Space)
  (type MeetingRoom)
  (width
    (value 3.6 m)
    (source "As-built check AB-2026-009, Acme Surveys")
    (method method:total-station)
    (accuracy (independent 0.003 m))
    (date "2026-05-06"))
  (width
    (value 3.65 m)
    (source "As-built check AB-2026-010, Acme Surveys")
    (method method:total-station)
    (accuracy (independent 0.003 m))
    (date "2026-05-06")))

; The rule written on the thing rather than by its type: fails, and says to take
; the assertion off rather than the invariant.
(node site:C-01
  (label "Level 1 corridor")
  (kind Space)
  (type Corridor)
  (assert required-claim (predicate width)))

(vertex geom:V-01
  (frame frame:building)
  (position
    (value (0.0 0.0) m)
    (source "Interior control set IC-01, Acme Surveys")
    (method method:total-station)
    (accuracy (independent 0.004 m))
    (date "2026-02-18"))
  (assert required-claim (predicate position)))

(vertex geom:V-02
  (frame frame:building)
  (position
    (value (4.0 0.0) m)
    (source "Interior control set IC-01, Acme Surveys")
    (method method:total-station)
    (accuracy (independent 0.004 m))
    (date "2026-02-18")))

(vertex geom:V-03
  (frame frame:building)
  (position
    (value (0.0 3.0) m)
    (source "Interior control set IC-01, Acme Surveys")
    (method method:total-station)
    (accuracy (independent 0.004 m))
    (date "2026-02-18")))

; A corner nobody has placed.
(vertex geom:V-04
  (frame frame:building)
  (assert required-claim (predicate position)))

(edge geom:E-01
  (frame frame:building)
  (vertices geom:V-01 geom:V-02)
  (width
    (value 0.2 m)
    (source "Fit-out drawing FD-2026-011")
    (method method:drawing-take-off)
    (accuracy (independent 0.01 m))
    (date "2026-03-02"))
  (assert required-claim (predicate width)))

(edge geom:E-02
  (frame frame:building)
  (vertices geom:V-02 geom:V-03)
  (assert required-claim (predicate width)))

(edge geom:E-03
  (frame frame:building)
  (vertices geom:V-03 geom:V-01))

(loop geom:L-01
  (frame frame:building)
  (edges geom:E-01 geom:E-02 geom:E-03)
  (assert required-claim (predicate width)))
