    (value 8.5 m)
    (source "Plan set A-101, sheet 3")
    (method method:scaled-from-plan)
    (accuracy (independent 0.05 m))
    (date "2026-01-09")
    (rank deprecated))
  (width
    (value 8.6 m)
    (source "Field sketch FS-11")
    (method method:scaled-from-plan)
    (date "2026-01-14")
    (rank deprecated)))
