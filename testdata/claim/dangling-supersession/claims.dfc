; A deprecation naming a claim this model does not hold. The as-built check
; which replaced the estimate is written below it and left its (id ...) out, so
; the name the deprecation reaches for belongs to nothing.
;
; The claim which was retracted is still readable, and what replaced it is not
; reachable from it, which is the half of the record supersession exists to
; keep.
(node site:S-101
  (kind Space)
  (type MeetingRoom)
  (geometry area)
  (width
    (id survey:C-0210)
    (value 8.5 m)
    (source "Plan set A-101, sheet 3")
    (method method:scaled-from-plan)
    (accuracy (independent 0.05 m))
    (date "2026-01-09")
    (rank deprecated)
    (superseded-by survey:C-0212))
  (width
    (value 8.53 m)
    (source "As-built check AB-2026-009, Acme Surveys")
    (method method:total-station)
    (accuracy (independent 0.003 m))
    (date "2026-05-06")))
