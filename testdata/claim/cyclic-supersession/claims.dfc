; Two rings of claims which replace one another: a pair each of which was
; deprecated in favour of the other, and three which chase one another round.
;
; Every claim in each ring is retracted and none of them is standing in the
; place of anything, so the model says the vertex is somewhere and can name no
; claim which still asserts where.
(vertex geom:V-02
  (frame frame:building)
  (position
    (id survey:C-0104)
    (value (4.0 0.0 0.0) m)
    (source "Interior control set IC-01, Acme Surveys")
    (method method:total-station)
    (accuracy (independent 0.004 m))
    (date "2026-02-18")
    (rank deprecated)
    (superseded-by survey:C-0181))
  (position
    (id survey:C-0181)
    (value (4.05 0.0 0.0) m)
    (source "As-built check AB-2026-009, Acme Surveys")
    (method method:total-station)
    (accuracy (independent 0.003 m))
    (date "2026-05-06")
    (rank deprecated)
    (superseded-by survey:C-0104)))

