; One room, the loop which bounds it, and the zone it belongs to — each carrying
; the assertions somebody looking at it wrote there.
;
; An assertion is attached to the thing it constrains rather than gathered into
; a file of rules, so "this room's boundary has to close" is read by whoever
; opens the room. All four forms carry them, and which of them a check may be
; written on is the check's own declaration: a check about the endpoints of an
; edge is written on the edge, and writing it on a room is a load error rather
; than a rule which quietly never fires.
(node site:S-101
  (label "Meeting Room B")
  (kind Space)
  (type MeetingRoom)
  (geometry area)
  (frame frame:building)
  (member-of site:Z-01)
  (boundary geom:L-01)
  (width
    (id survey:W-0001)
    (value 4.2 m)
    (source "As-built check AB-2026-009, Acme Surveys")
    (method method:total-station)
    (accuracy (independent 0.003 m))
    (date "2026-05-06"))
  (assert within-resolves)
  (assert required-claim (predicate width))
  (assert boundary-loops-close (tolerance boundary-closure)))

; A node with no shape at all carries the assertions which do not need one. A
; check declaring no geometry form applies to every subject including this one,
; which is what keeps a circuit group, a warranty and a zone from being special
; cases.
(node site:Z-01
  (label "Level 1 occupancy")
  (kind Zone)
  (type OccupancyZone)
  (assert required-claim (predicate width)))

(vertex geom:V-01
  (label "Room B, north-west corner")
  (frame frame:building)
  (position
    (value (0.0 0.0 0.0) m)
    (source "Interior control set IC-01, Acme Surveys")
    (method method:total-station)
    (accuracy (independent 0.004 m))
    (date "2026-02-18"))
  (assert required-claim (predicate position)))

(vertex geom:V-02
  (label "Room B, north-east corner")
  (frame frame:building)
  (position
    (value (4.0 0.0 0.0) m)
    (source "Interior control set IC-01, Acme Surveys")
    (method method:total-station)
    (accuracy (independent 0.004 m))
    (date "2026-02-18")))

(vertex geom:V-03
  (label "Room B, south-east corner")
  (frame frame:building)
  (position
    (value (4.0 3.0 0.0) m)
    (source "Interior control set IC-01, Acme Surveys")
    (method method:total-station)
    (accuracy (independent 0.004 m))
    (date "2026-02-18")))

(vertex geom:V-04
  (label "Room B, south-west corner")
  (frame frame:building)
  (position
    (value (0.0 3.0 0.0) m)
    (source "Interior control set IC-01, Acme Surveys")
    (method method:total-station)
    (accuracy (independent 0.004 m))
    (date "2026-02-18")))

(edge geom:E-01
  (label "Room B, north wall")
  (frame frame:building)
  (vertices geom:V-01 geom:V-02)
  (assert edge-endpoints-differ))

(edge geom:E-02 (label "Room B, east wall") (frame frame:building) (vertices geom:V-02 geom:V-03))

(edge geom:E-03 (label "Room B, south wall") (frame frame:building) (vertices geom:V-03 geom:V-04))

(edge geom:E-04 (label "Room B, west wall") (frame frame:building) (vertices geom:V-04 geom:V-01))

(loop geom:L-01
  (label "Meeting Room B boundary")
  (frame frame:building)
  (edges geom:E-01 geom:E-02 geom:E-03 geom:E-04)
  (assert boundary-loops-close (tolerance boundary-closure)))
