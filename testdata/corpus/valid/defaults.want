; Specification section 8.2. A child equal to its default is not printed,
; however it was spelled: #true and #t are one value, and both spellings load.
; The non-default value of each is written here beside it so that the pair can
; be read together.
(predicate
  colour
  (shape text)
  (description "A finish named rather than measured."))
(predicate
  nominal-width
  (unit m)
  (shape scalar)
  (claim-bearing #f)
  (strict #t)
  (description "The width a partition was specified at."))
(vertex
  geom:V-02
  (frame frame:building)
  (position
    (id survey:C-0104)
    (value (4.0 0.0 0.0) m)
    (source "Interior control set IC-01, Acme Surveys")
    (method method:total-station)
    (date "2026-02-18"))
  (position
    (id survey:C-0181)
    (value (4.05 0.0 0.0) m)
    (source "As-built check AB-2026-009, Acme Surveys")
    (method method:total-station)
    (date "2026-05-06")
    (rank deprecated)
    (superseded-by survey:C-0104)))
