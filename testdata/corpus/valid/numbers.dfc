; Specification sections 4.3 and 8.4. A real is written with a fraction or an
; exponent so that it reads back as a real; a count is written with neither. A
; number prints as the shortest decimal which reads back as the same value, so
; trailing zeros are dropped and two spellings of one value converge — what a
; measurement is good to is its accuracy, written down, not how it was typed.
(predicate position
  (unit m)
  (shape coordinate)
  (dimension 3)
  (description "The location of a vertex in its frame."))

(tolerance boundary-closure (value 0.005 m))

(tolerance trailing-zeros (value 8.50 m))

(tolerance written-as-an-exponent (value 3.0e2 m))

(tolerance no-shorter-spelling (value 0.30000000000000004 m))

(vertex geom:V-01
  (frame frame:building)
  (position
    (value (401235.117 -3172884.902 0.0) m)
    (source "Interior control set IC-01, Acme Surveys")
    (method method:total-station)
    (accuracy (independent 0.004 m))
    (date "2026-02-18")))
