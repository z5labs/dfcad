; A number prints as the shortest decimal which reads back as the same value.
; These are written under a tag the format does not know, so that the fixture is
; about the numbers and about nothing else.
(counts 0 1 -1 3 9223372036854775807 -9223372036854775808)
(reals 8.50 100.0 0.30000000000000004 -0.0 1e21 1e-7 0.1 1.7976931348623157e308
  5e-324 1200.0 0.000001 1234567890123456789.0 -2.5 3.0e2 0.1e1)
