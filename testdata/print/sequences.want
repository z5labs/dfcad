(frame
  frame:building
  (unit m)
  (parent frame:survey-grid)
  (transform survey:C-0031)
  (frame-transform
    (id survey:C-0031)
    (value
      (transform
        (translation 401235.117 3.172884902e+06 44.318)
        (rotation 0.9999985 -0.0017453 0.0 0.0017453 0.9999985 0.0 0.0 0.0 1.0)
        (scale 1.0)))
    (source "Georeferencing report GR-2026-002, Acme Surveys")
    (method method:gnss-static)
    (accuracy (independent 0.012 m) (systematic 0.008 m survey:CP-3))
    (date "2026-02-11")))
(vertex
  geom:V-07
  (frame frame:building)
  (position
    (value (8.0 3.0 0.0) m)
    (source "Interior control set IC-01, Acme Surveys")
    (method method:total-station)
    (date "2026-02-18")))
(edge geom:E-09 (frame frame:building) (vertices geom:V-06 geom:V-05))
; Nothing below is sorted: every one of these orders is data.
(loop
  geom:L-01
  (frame frame:building)
  (edges geom:E-04 geom:E-01 geom:E-03 geom:E-02))
