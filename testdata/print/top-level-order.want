(project (globalid-namespace "https://example.org/models/riverside"))
(namespace geom (description "Geometric nodes minted by this model."))
(namespace site (description "Semantic nodes minted by this model."))
(type MeetingRoom (kind Space) (geometry area) (description "A room."))
(predicate position (shape coordinate))
(tolerance boundary-closure (value 0.005 m))
(frame frame:building (unit m))
(node site:S-101 (kind Space) (type MeetingRoom))
(node site:S-102 (kind Space) (type Corridor))
(vertex geom:V-01 (frame frame:building))
(vertex geom:V-02 (frame frame:building))
(edge geom:E-01 (frame frame:building) (vertices geom:V-01 geom:V-02))
(edge geom:E-02 (frame frame:building) (vertices geom:V-02 geom:V-01))
(loop geom:L-01 (frame frame:building) (edges geom:E-01))
(loop geom:L-02 (frame frame:building) (edges geom:E-02))
