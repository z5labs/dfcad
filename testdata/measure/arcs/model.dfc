  (label "Room with a bay window")
  (kind Space)
  (type MeetingRoom)
  (geometry area)
  (frame frame:building)
  (boundary geom:L-01))

; The same four edges written in the order the ring runs the other way round,
; which traverses the bay window from the far end. A bulge belongs to the wall
; and not to the traversal, so the same curve bows out of both and the two
; measure the same.
(loop geom:L-02
  (label "Bay room boundary, written backwards")
  (frame frame:building)
  (edges geom:E-04 geom:E-03 geom:E-02 geom:E-01))
(node site:S-02
  (label "Room with a bay window, written backwards")
  (kind Space)
  (type MeetingRoom)
  (geometry area)
  (frame frame:building)
  (boundary geom:L-02))

; The same room with the same wall curved the other way, so the bay is a bite
; out of it rather than an addition to it. Nothing but the direction the sweep
; runs through differs, which is the whole of what the point on the wall says.
(vertex geom:V-11
  (label "Alcove room, corner 1")
