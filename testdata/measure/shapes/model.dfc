; The four shapes whose sizes are worked out by hand in measure_test.go, and
; the same square written two more ways.
;
; None of the sizes is written down anywhere here. A square is four vertices,
; four edges and a loop; that it is twelve square metres is computed from those
; every time it is asked, so moving a corner changes the answer with no other
; edit and no number left behind to disagree with it.
(vertex geom:V-01
  (label "Square room, corner 1")
  (frame frame:building)
  (position
    (value (0.0 0.0 0.0) m)
    (source "Interior control set IC-01, Acme Surveys")
    (method method:total-station)
    (accuracy (independent 0.004 m) (systematic 0.008 m control:CP-3))
    (date "2026-02-18")))
(vertex geom:V-02
  (label "Square room, corner 2")
  (frame frame:building)
  (position
    (value (4.0 0.0 0.0) m)
    (source "Interior control set IC-01, Acme Surveys")
    (method method:total-station)
    (accuracy (independent 0.004 m) (systematic 0.008 m control:CP-3))
    (date "2026-02-18")))
(vertex geom:V-03
  (label "Square room, corner 3")
  (frame frame:building)
  (position
    (value (4.0 3.0 0.0) m)
    (source "Interior control set IC-01, Acme Surveys")
    (method method:total-station)
    (accuracy (independent 0.004 m) (systematic 0.008 m control:CP-3))
    (date "2026-02-18")))
(vertex geom:V-04
  (label "Square room, corner 4")
  (frame frame:building)
  (position
    (value (0.0 3.0 0.0) m)
    (source "Interior control set IC-01, Acme Surveys")
    (method method:total-station)
    (accuracy (independent 0.004 m) (systematic 0.008 m control:CP-3))
    (date "2026-02-18")))
(edge geom:E-01 (label "Square room, side 1") (frame frame:building) (vertices geom:V-01 geom:V-02))
(edge geom:E-02 (label "Square room, side 2") (frame frame:building) (vertices geom:V-02 geom:V-03))
(edge geom:E-03 (label "Square room, side 3") (frame frame:building) (vertices geom:V-03 geom:V-04))
(edge geom:E-04 (label "Square room, side 4") (frame frame:building) (vertices geom:V-04 geom:V-01))
(loop geom:L-01
  (label "Square room boundary")
  (frame frame:building)
  (edges geom:E-01 geom:E-02 geom:E-03 geom:E-04))
(node site:S-01
  (label "Square room")
  (kind Space)
  (type MeetingRoom)
  (geometry area)
  (frame frame:building)
  (boundary geom:L-01))

; The same four edges, written in the order the ring runs the other way round,
; and again starting from a different one of them. A size is a property of the
; shape and not of where somebody began writing it down, so all three of these
; measure the same.
(loop geom:L-02
  (label "Square room boundary, written backwards")
  (frame frame:building)
  (edges geom:E-04 geom:E-03 geom:E-02 geom:E-01))
(node site:S-02
  (label "Square room, written backwards")
  (kind Space)
  (type MeetingRoom)
  (geometry area)
  (frame frame:building)
  (boundary geom:L-02))
(loop geom:L-03
  (label "Square room boundary, written from the second edge")
  (frame frame:building)
  (edges geom:E-02 geom:E-03 geom:E-04 geom:E-01))
(node site:S-03
  (label "Square room, written from the second edge")
  (kind Space)
  (type MeetingRoom)
  (geometry area)
  (frame frame:building)
  (boundary geom:L-03))

