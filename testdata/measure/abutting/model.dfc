(edge geom:E-01 (label "Counter body, side 1") (frame frame:building) (vertices geom:V-01 geom:V-02))
(edge geom:E-02 (label "Counter body, side 2") (frame frame:building) (vertices geom:V-02 geom:V-03))
(edge geom:E-03 (label "Counter body, side 3") (frame frame:building) (vertices geom:V-03 geom:V-04))
(edge geom:E-04 (label "Counter body, side 4") (frame frame:building) (vertices geom:V-04 geom:V-01))
(loop geom:L-01
  (label "Counter body boundary")
  (frame frame:building)
  (edges geom:E-01 geom:E-02 geom:E-03 geom:E-04))

; The return: four by two, eight square metres. It shares the corner geom:V-01
; with the body and runs along part of the body's side geom:E-04, which is what
; puts two of its corners on the body's boundary.
(vertex geom:V-11
