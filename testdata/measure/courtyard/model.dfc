; A ten-metre floor plate with a four-metre courtyard in the middle of it.
;
; Nothing here says which of the two rings is the outside one. The one inside
; the other is a hole and is taken away, which is what makes a courtyard
; subtract with no edit which declares it one.
(vertex geom:V-01
  (label "Floor plate, corner 1")
  (frame frame:building)
  (position
    (value (0.0 0.0 0.0) m)
    (source "Interior control set IC-01, Acme Surveys")
    (method method:total-station)
    (accuracy (independent 0.004 m) (systematic 0.008 m control:CP-3))
    (date "2026-02-18")))
(vertex geom:V-02
  (label "Floor plate, corner 2")
  (frame frame:building)
  (position
    (value (10.0 0.0 0.0) m)
    (source "Interior control set IC-01, Acme Surveys")
    (method method:total-station)
    (accuracy (independent 0.004 m) (systematic 0.008 m control:CP-3))
    (date "2026-02-18")))
(vertex geom:V-03
  (label "Floor plate, corner 3")
  (frame frame:building)
  (position
    (value (10.0 10.0 0.0) m)
    (source "Interior control set IC-01, Acme Surveys")
    (method method:total-station)
    (accuracy (independent 0.004 m) (systematic 0.008 m control:CP-3))
    (date "2026-02-18")))
(vertex geom:V-04
  (label "Floor plate, corner 4")
  (frame frame:building)
