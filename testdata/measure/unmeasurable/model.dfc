; A square room, one of whose corners nobody has surveyed yet.
;
; The ring closes — closure is decided by which vertices the edges name — and
; there is still nothing to measure it with. That is a state and not a failure
; of the model, and it is reported as the one corner it is about.
(vertex geom:V-01
  (label "Half-surveyed room, corner 1")
  (frame frame:building)
  (position
    (value (0.0 0.0 0.0) m)
    (source "Interior control set IC-01, Acme Surveys")
    (method method:total-station)
    (accuracy (independent 0.004 m) (systematic 0.008 m control:CP-3))
    (date "2026-02-18")))
(vertex geom:V-02
  (label "Half-surveyed room, corner 2")
  (frame frame:building)
  (position
    (value (4.0 0.0 0.0) m)
    (source "Interior control set IC-01, Acme Surveys")
    (method method:total-station)
    (accuracy (independent 0.004 m) (systematic 0.008 m control:CP-3))
    (date "2026-02-18")))
(vertex geom:V-03
  (label "Half-surveyed room, corner 3")
  (frame frame:building))
(vertex geom:V-04
  (label "Half-surveyed room, corner 4")
  (frame frame:building)
  (position
    (value (0.0 3.0 0.0) m)
    (source "Interior control set IC-01, Acme Surveys")
    (method method:total-station)
    (accuracy (independent 0.004 m) (systematic 0.008 m control:CP-3))
    (date "2026-02-18")))
(edge geom:E-01 (label "Half-surveyed room, side 1") (frame frame:building) (vertices geom:V-01 geom:V-02))
(edge geom:E-02 (label "Half-surveyed room, side 2") (frame frame:building) (vertices geom:V-02 geom:V-03))
(edge geom:E-03 (label "Half-surveyed room, side 3") (frame frame:building) (vertices geom:V-03 geom:V-04))
(edge geom:E-04 (label "Half-surveyed room, side 4") (frame frame:building) (vertices geom:V-04 geom:V-01))
(loop geom:L-01
  (label "Half-surveyed room boundary")
  (frame frame:building)
  (edges geom:E-01 geom:E-02 geom:E-03 geom:E-04))
(node site:S-01
  (label "Half-surveyed room")
  (kind Space)
  (type MeetingRoom)
  (geometry area)
  (frame frame:building)
  (boundary geom:L-01))
