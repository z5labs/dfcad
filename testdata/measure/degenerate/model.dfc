; Three shapes which are not shapes, and one edge which is not an edge.
;
; Each is a different mistake with a different fix, which is why each produces
; its own diagnostic rather than one answer of zero that reads as a measurement.
(vertex geom:V-01
  (label "Collinear room, corner 1")
  (frame frame:building)
  (position
    (value (0.0 0.0 0.0) m)
    (source "Interior control set IC-01, Acme Surveys")
    (method method:total-station)
    (accuracy (independent 0.004 m) (systematic 0.008 m control:CP-3))
    (date "2026-02-18")))
(vertex geom:V-02
  (label "Collinear room, corner 2")
  (frame frame:building)
  (position
    (value (2.0 0.0 0.0) m)
    (source "Interior control set IC-01, Acme Surveys")
    (method method:total-station)
    (accuracy (independent 0.004 m) (systematic 0.008 m control:CP-3))
    (date "2026-02-18")))
(vertex geom:V-03
  (label "Collinear room, corner 3")
  (frame frame:building)
  (position
    (value (4.0 0.0 0.0) m)
    (source "Interior control set IC-01, Acme Surveys")
    (method method:total-station)
    (accuracy (independent 0.004 m) (systematic 0.008 m control:CP-3))
    (date "2026-02-18")))
(edge geom:E-01 (label "Collinear room, side 1") (frame frame:building) (vertices geom:V-01 geom:V-02))
(edge geom:E-02 (label "Collinear room, side 2") (frame frame:building) (vertices geom:V-02 geom:V-03))
(edge geom:E-03 (label "Collinear room, side 3") (frame frame:building) (vertices geom:V-03 geom:V-01))
(loop geom:L-01
  (label "Collinear room boundary")
  (frame frame:building)
  (edges geom:E-01 geom:E-02 geom:E-03))
(node site:S-01
  (label "Collinear room")
  (kind Space)
  (type MeetingRoom)
  (geometry area)
  (frame frame:building)
  (boundary geom:L-01))

