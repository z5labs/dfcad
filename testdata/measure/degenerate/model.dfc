; Two corners surveyed to one coordinate, and the edge somebody wrote between
; them. The geometric loader refuses an edge from a vertex to itself; this is
; the same mistake made with two ids, which only a measurement can see.
(vertex geom:V-21
  (label "Collapsed wall, one end")
  (frame frame:building)
  (position
    (value (20.0 0.0 0.0) m)
    (source "Interior control set IC-01, Acme Surveys")
    (method method:total-station)
    (accuracy (independent 0.004 m) (systematic 0.008 m control:CP-3))
    (date "2026-02-18")))
(vertex geom:V-22
  (label "Collapsed wall, the other end")
  (frame frame:building)
  (position
    (value (20.0 0.0 0.0) m)
    (source "Interior control set IC-01, Acme Surveys")
    (method method:total-station)
    (accuracy (independent 0.004 m) (systematic 0.008 m control:CP-3))
    (date "2026-02-18")))
(edge geom:E-21 (label "Collapsed wall") (frame frame:building) (vertices geom:V-21 geom:V-22))

; A ring which passes through one corner twice, written as two vertices
; surveyed to the same coordinate. Six edges, each traversed once, and a corner
; where four of them meet — which is a branch and not a room.
(vertex geom:V-31
  (label "Pinched room, corner 1")
  (frame frame:building)
  (position
    (value (30.0 0.0 0.0) m)
